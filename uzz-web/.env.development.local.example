# Copy to .env.development.local for local dev.
# Leave NEXT_PUBLIC_API_URL empty — Next.js rewrites proxy /trpc/uzz → localhost:8002 (same-origin, no CORS).
# NEXT_PUBLIC_API_URL=

# Required for community-scoped procedures (banks, lots, deals, …).
# NEXT_PUBLIC_DEFAULT_COMMUNITY_ID=

# Optional public origin for magic-link redirects (defaults to current origin in browser).
# NEXT_PUBLIC_APP_URL=http://localhost:8004

# Fake auth button on login/home (defaults on in development unless set to false).
# NEXT_PUBLIC_FAKE_DATA_MODE=true
