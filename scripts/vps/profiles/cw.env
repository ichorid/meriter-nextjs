# Live UZZ + @meriter_bot host (37.139.43.179 / cw.ru).
# Not applied by GitHub deploy-dev/deploy-prod. Keep these keys in /opt/meriter/.env
# on that VPS. Secrets (BOT_TOKEN, Mongo, JWT) stay only on the server.

DOMAIN=cw.ru
# Meriter Next site must not share the hostname with UZZ (Caddy ambiguous site).
MERITER_DOMAIN=legacy.localhost
UZZ_DOMAIN=cw.ru
UZZ_WEB_BASE_URL=https://cw.ru
# Public community-web without extra DNS (A record of the VPS).
COMMUNITY_DOMAIN=community.37.139.43.179.sslip.io
COMMUNITY_WEB_BASE_URL=https://community.37.139.43.179.sslip.io

MERITER_PRODUCT_MODE=telegram_mvp
# Telegram DCs time out to 37.139.43.179. Ingress is Caddy on DigitalOcean
# (dev.meriter.pro /api/telegram/hooks* → https://cw.ru). Do not pin ip_address.
TELEGRAM_WEBHOOK_BASE_URL=https://dev.meriter.pro
TELEGRAM_BOT_ENABLED=true
OAUTH_TELEGRAM_ENABLED=true
BOT_USERNAME=meriter_bot
OAUTH_TELEGRAM_BOT_USERNAME=meriter_bot
