# Dev VPS (159.223.212.122 / dev.meriter.pro).
# @meriter_bot webhook+menu live on cw.ru after the Mongo clone. Leave the bot
# disabled here so deploy-dev cannot steal the Telegram webhook. Raise a
# separate BotFather token when a dedicated dev bot is needed again.

DOMAIN=dev.meriter.pro
MERITER_DOMAIN=dev.meriter.pro
COMMUNITY_DOMAIN=community-dev.meriter.pro
COMMUNITY_WEB_BASE_URL=https://community-dev.meriter.pro
UZZ_DOMAIN=uzz-dev.meriter.pro
UZZ_WEB_BASE_URL=https://uzz-dev.meriter.pro
# Stable database id of the Telegram community used by the UZZ pilot.
DEFAULT_TELEGRAM_COMMUNITY_ID=a1000001-0000-4000-8000-000000000001

MERITER_PRODUCT_MODE=telegram_mvp
TELEGRAM_BOT_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
OAUTH_TELEGRAM_ENABLED=true
BOT_USERNAME=meriter_bot
OAUTH_TELEGRAM_BOT_USERNAME=meriter_bot
