# Copy the needed keys into your local .env for the UZZ human stand.
# Do not point a local API at the VPS @meriter_bot token.

NODE_ENV=development
FAKE_DATA_MODE=false
TEST_AUTH_MODE=false
PORT=8002
DOMAIN=localhost
MONGO_URL=mongodb://127.0.0.1:27017/meriter
MONGO_URL_SECONDARY=mongodb://127.0.0.1:27017/meriter

UZZ_DOMAIN=localhost
UZZ_WEB_BASE_URL=http://127.0.0.1:8004
DEFAULT_TELEGRAM_COMMUNITY_ID=a1000001-0000-4000-8000-000000000001

EMAIL_ENABLED=true
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=https://go1.unisender.ru/ru/transactional/api/v1

# Optional local-only bot. Leave disabled if you will bind Telegram on uzz-dev.meriter.pro.
TELEGRAM_BOT_ENABLED=false
BOT_TOKEN=
BOT_USERNAME=

API_URL=http://127.0.0.1:8002
